# Template for the local environment of docker-compose.yml.
# Copy it to .env (which Git ignores) and replace every value. Never commit real secrets.

# Password of the PostgreSQL "postgres" user. It is stored in the database volume the first time it starts, so
# changing it later requires recreating the volume (docker compose down -v) or ALTER USER.
POSTGRES_PASSWORD=change-me

# Secret used to sign the JWT tokens: a long random text of at least 40 characters.
JWT_SECRET=change-me-to-a-long-random-text-of-at-least-40-characters

# Optional: administrator created at the first startup when both values are set.
SAFESTEP_ADMIN_USERNAME=
SAFESTEP_ADMIN_PASSWORD=

# Optional: Stripe test keys, needed only to try the card checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
